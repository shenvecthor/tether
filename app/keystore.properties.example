# Copy this file to keystore.properties (same folder) and fill it in.
# keystore.properties and your .jks file are git-ignored — never commit them.
#
# Create a key once with (JDK keytool, bundled with Android Studio):
#   keytool -genkeypair -v -keystore tether-release.jks -alias tether -keyalg RSA -keysize 3072 -validity 10000
#
storeFile=tether-release.jks
storePassword=CHANGE_ME
keyAlias=tether
keyPassword=CHANGE_ME
